# OnePlus 7T (hotdogb): audio (WCD9340 on SLIMbus + QDSP6 front ends)
#
#   scripts/kconfig/merge_config.sh -m .config \
#       configs/hotdogb-display-touch.config configs/hotdogb-audio.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig
#
# Everything here is a module so the initramfs can load the stack in
# dependency order once the ADSP and the SLIMbus controller are up.  SLIMBUS
# itself stays built in: the controller device is created from the DTB at boot
# and the codec drivers attach to it later.

# --- sound core ----------------------------------------------------------
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QCOM_COMMON=m

# --- Qualcomm DSP (APR / Q6) --------------------------------------------
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SM8150=m

# --- TFA9874 speaker amplifiers -----------------------------------------
CONFIG_SND_SOC_TFA9874=m

# --- WCD9340 codec -------------------------------------------------------
CONFIG_MFD_WCD934X=m
CONFIG_SND_SOC_WCD934X=m
CONFIG_SND_SOC_WCD_CLASSH=m
CONFIG_SND_SOC_WCD_MBHC=m
CONFIG_REGMAP_SLIMBUS=m

# --- SLIMbus / SoundWire -------------------------------------------------
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
