# OnePlus 7T (hotdogb): display + touchscreen
#
#   scripts/kconfig/merge_config.sh -m .config configs/hotdogb-display-touch.config
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- olddefconfig

# --- DRM / MSM -------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# arm64 defconfig has these as modules, which caps DRM_MSM at "m".  A modular
# DRM_MSM leaves CONFIG_DRM_KMS_HELPER=m too (it is a hidden symbol), so a
# built-in panel driver ends up with an undefined reference to
# drm_connector_helper_get_modes_fixed() while linking vmlinux.  Keep the whole
# display stack built in.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_COMMAND_DB=y

CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_KMS_FBDEV=y

# --- panel ---------------------------------------------------------------
CONFIG_DRM_PANEL_SAMSUNG_SOFEF03F=y

# --- I2C / regulators ----------------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_QCOM_LABIBB=y

# --- touchscreen (Synaptics RMI4) ---------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_2D_SENSOR=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
