# OnePlus 7T (hotdogb): netboot root over NBD, postmarketOS style.
#
# initramfs/init brings up the USB RNDIS gadget, takes 172.16.42.1/24 and
# connects nbd-client to the PC at 172.16.42.2:9999.  NBD has to be built in:
# the root filesystem is mounted before any module could be loaded from it.

CONFIG_BLK_DEV_NBD=y
