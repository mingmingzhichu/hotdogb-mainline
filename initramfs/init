#!/bin/busybox.static sh
# Minimal userspace for OnePlus 7T (hotdogb) mainline.
#
#   1. mount proc/sys/dev/debugfs
#   2. bind a CDC-ACM USB gadget (1d6b:0104) so the host gets COMx
#   3. serve a line-oriented command protocol on /dev/ttyGS0
#   4. (background) start the radio stack: EFS copy, rmtfs, pd-mapper,
#      tqftpserv, MPSS, then the WCN3990 modules
#
# Protocol (what hd_cmd.ps1 expects):
#   device -> host : "__R__"   ready for a command
#   device -> host : "__B__"   command output starts
#   device -> host : "__E__"   command output ends

/bin/busybox.static --install -s /bin 2>/dev/null

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null
mkdir -p /sys/kernel/debug
mount -t debugfs none /sys/kernel/debug 2>/dev/null

say() { echo "<6>init: $*" > /dev/kmsg 2>/dev/null; }

say "userspace up"

# ------------------------------------------------------- radio stack --------
# The WLAN chip is not standalone: WCN3990 is brought up by MPSS, and MPSS
# needs three userspace services or it asserts within a minute.
#
#   rmtfs      - serves the modem's EFS (modem_fs1/2, fsc, fsg) over QRTR.
#   pd-mapper  - answers protection-domain lookups (the PD maps are the .jsn
#                files next to the modem firmware).
#   tqftpserv  - firmware file service used by the DSPs.
#
# EFS lives on the UFS partitions; it is copied into RAM so the daemons never
# write to flash, and /dev/qcom_rmtfs_mem1 is only a shared-memory channel.
(
	mkdir -p /tmp/rmtfs

	# UFS probes in parallel with init, so the partitions may not exist yet.
	n=0
	while [ $n -lt 60 ]; do
		grep -lq '^PARTNAME=modemst1' /sys/block/sd*/sd*/uevent 2>/dev/null && break
		sleep 1
		n=$((n + 1))
	done
	say "EFS partitions visible after ${n}s"

	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		name=$(sed -n 's/^PARTNAME=//p' "$d/uevent")
		case "$name" in
		modemst1) out=modem_fs1 ;;
		modemst2) out=modem_fs2 ;;
		fsg) out=modem_fsg ;;
		fsc) out=modem_fsc ;;
		oem_stanvbk|oem_dycnvbk) out=$name ;;
		*) continue ;;
		esac
		dev=/dev/${d##*/}
		[ -b "$dev" ] && dd if="$dev" of="/tmp/rmtfs/$out" bs=1M 2>/dev/null
	done

	# tqftpserv serves the WLAN firmware's /readwrite/ requests (MAC address,
	# calibration) out of /var/lib/tqftpserv.  Its mkdir() is not recursive,
	# so without the parent directory it cannot create the directory itself
	# and MPSS never publishes the WLFW service -- ath10k then waits forever
	# in its QMI lookup.  Populate it from persist, read-only.
	mkdir -p /var/lib/tqftpserv /tmp/persist
	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$d/uevent")" = persist ] || continue
		if mount -t ext4 -o ro "/dev/${d##*/}" /tmp/persist; then
			cp -a /tmp/persist/. /var/lib/tqftpserv/ 2>/dev/null
			umount /tmp/persist
		fi
		break
	done
	say "tqftpserv readwrite: $(ls /var/lib/tqftpserv 2>/dev/null | tr '\n' ' ')"

	# The modem partition carries the WLAN firmware image built for this
	# handset's modem.  Reusing another sm8150 device's wlanmdsp.mbn makes
	# ath10k's "assign msa map permissions" SCM call fail with -EINVAL, and
	# with qcom,msa-fixed-perm the WLAN subsystem then faults so hard that
	# the whole chip resets into EDL.  Read-only; nothing is written back.
	mkdir -p /tmp/modempart
	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$d/uevent")" = modem_a ] || continue
		if mount -t vfat -o ro "/dev/${d##*/}" /tmp/modempart; then
			cp -f /tmp/modempart/image/wlanmdsp.mbn \
				/lib/firmware/qcom/sm8150/oneplus7/ 2>/dev/null
			umount /tmp/modempart
			say "wlanmdsp $(wc -c < /lib/firmware/qcom/sm8150/oneplus7/wlanmdsp.mbn 2>/dev/null) bytes"
		else
			say "modem_a mount failed"
		fi
		break
	done

	n=0
	while [ $n -lt 30 ] && [ ! -c /dev/qcom_rmtfs_mem1 ]; do
		sleep 1
		n=$((n + 1))
	done

	if [ -c /dev/qcom_rmtfs_mem1 ]; then
		/bin/rmtfs -o /tmp/rmtfs -v > /tmp/rmtfs.log 2>&1 &
	else
		say "no /dev/qcom_rmtfs_mem1"
	fi
	sleep 1
	/bin/pd-mapper > /tmp/pd-mapper.log 2>&1 &
	/bin/tqftpserv > /tmp/tqftpserv.log 2>&1 &
	sleep 1
	say "radio services up"

	# modem.mbn is 75 MB, which makes the boot image too big for
	# `fastboot boot` on this bootloader, so it is copied in afterwards and
	# /bin/radio_up.sh starts MPSS and the wireless modules.
	FW=/lib/firmware/qcom/sm8150/oneplus7
	if [ -f "$FW/modem.mbn" ]; then
		/bin/radio_up.sh > /tmp/radio.log 2>&1
	else
		say "modem.mbn absent; run /bin/radio_up.sh after copying it"
	fi
) &


# ------------------------------------------------------------- usb drive -----
# A RAM-backed FAT image, exported to the host as a USB mass-storage LUN, so
# logs can be pulled off the board at USB speed.  Nothing on the real
# partitions is touched.
LUNIMG=/tmp/lun.img
LUN_OK=
dd if=/dev/zero of="$LUNIMG" bs=1M count=220 2>/dev/null
if /bin/busybox.static mkfs.vfat -n HOTDOGB "$LUNIMG" >/dev/null 2>&1; then
	LUN_OK=1
	say "lun image ready"
fi

# ---------------------------------------------------------------- serial -----
# Nothing below may block this: the console is the only way to debug the board.
n=0
while [ $n -lt 60 ] && [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; do
	sleep 1
	n=$((n + 1))
done
UDC=$(ls /sys/class/udc 2>/dev/null | head -1)

if [ -n "$UDC" ]; then
	mount -t configfs none /sys/kernel/config 2>/dev/null
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p "$G"
	# Linux Foundation CDC-ACM IDs: Windows binds usbser.sys and creates COMx.
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	echo 0x0100 > "$G/bcdDevice"
	echo 0x0200 > "$G/bcdUSB"
	mkdir -p "$G/strings/0x409"
	echo "dde12ac6" > "$G/strings/0x409/serialnumber"
	echo "OnePlus" > "$G/strings/0x409/manufacturer"
	echo "hotdogb mainline" > "$G/strings/0x409/product"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "acm" > "$G/configs/c.1/strings/0x409/configuration"
	mkdir -p "$G/functions/acm.usb0"
	ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
	if [ -n "$LUN_OK" ]; then
		mkdir -p "$G/functions/mass_storage.0"
		echo "$LUNIMG" > "$G/functions/mass_storage.0/lun.0/file"
		echo 1 > "$G/functions/mass_storage.0/lun.0/removable"
		ln -sf "$G/functions/mass_storage.0" "$G/configs/c.1/" 2>/dev/null
	fi
	echo "$UDC" > "$G/UDC"
	say "gadget bound to $UDC"
else
	say "no UDC found, serial console unavailable"
fi

# One command per line, output framed by __B__/__E__.  /bin/con is a tiny
# non-blocking server: a shell version deadlocks when the host closes COMx
# while a large output is still queued.  ttyGS0 only appears once the ACM
# function is bound, so the loop retries until it does.
(
	n=0
	while [ $n -lt 120 ] && [ ! -c /dev/ttyGS0 ]; do
		sleep 1
		n=$((n + 1))
	done
	say "console tty after ${n}s"
	while :; do
		/bin/con
		sleep 1
	done
) &

# PID 1 must never exit.
while :; do
	sleep 3600
done
