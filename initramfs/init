#!/bin/busybox.static sh
# Minimal userspace for OnePlus 7T (hotdogb) mainline.
#
#   1. mount proc/sys/dev/debugfs
#   2. bind a CDC-ACM USB gadget (1d6b:0104) so the host gets COMx
#   3. serve a line-oriented command protocol on /dev/ttyGS0
#   4. (background) start the radio stack: EFS copy, rmtfs, pd-mapper,
#      tqftpserv, MPSS, then the WCN3990 modules
#
# Protocol (what hd_cmd.ps1 expects):
#   device -> host : "__R__"   ready for a command
#   device -> host : "__B__"   command output starts
#   device -> host : "__E__"   command output ends

/bin/busybox.static --install -s /bin 2>/dev/null

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null
mkdir -p /sys/kernel/debug
mount -t debugfs none /sys/kernel/debug 2>/dev/null

say() { echo "<6>init: $*" > /dev/kmsg 2>/dev/null; }

# Read a key=value pair out of the kernel command line.
cmdline_var() {
	awk -v k="$1" '{
		for (i = 1; i <= NF; i++)
			if (index($i, k "=") == 1) {
				sub(k "=", "", $i);
				print $i;
				exit;
			}
	}' /proc/cmdline
}

CMDLINE=$(cat /proc/cmdline)
NETBOOT=
case "$CMDLINE" in
*hotdogb.netboot=1*) NETBOOT=1 ;;
esac

say "userspace up"

# ------------------------------------------------------------- netboot ------
# postmarketOS-style netboot: the root filesystem is a raw disk image served
# over NBD by the PC, reachable through the USB gadget Ethernet.  The device
# takes 172.16.42.1 (pmOS convention), the host is 172.16.42.2.
#
# This runs before the radio stack because there is no point bringing up
# Wi-Fi when the root filesystem comes from the cable.
if [ -n "$NETBOOT" ]; then
	NB_HOST=$(cmdline_var hotdogb.netboot.host)
	NB_PORT=$(cmdline_var hotdogb.netboot.port)
	NB_DEV=$(cmdline_var hotdogb.netboot.dev)
	NB_INIT=$(cmdline_var init)
	: "${NB_HOST:=172.16.42.2}"
	: "${NB_PORT:=9999}"
	: "${NB_DEV:=/dev/nbd0}"
	: "${NB_INIT:=/sbin/init}"
	say "netboot: host $NB_HOST port $NB_PORT"
fi

# ------------------------------------------------------- radio stack --------
# The WLAN chip is not standalone: WCN3990 is brought up by MPSS, and MPSS
# needs three userspace services or it asserts within a minute.
#
#   rmtfs      - serves the modem's EFS (modem_fs1/2, fsc, fsg) over QRTR.
#   pd-mapper  - answers protection-domain lookups (the PD maps are the .jsn
#                files next to the modem firmware).
#   tqftpserv  - firmware file service used by the DSPs.
#
# EFS lives on the UFS partitions; it is copied into RAM so the daemons never
# write to flash, and /dev/qcom_rmtfs_mem1 is only a shared-memory channel.
if [ -z "$NETBOOT" ]; then
(
	mkdir -p /tmp/rmtfs

	# UFS probes in parallel with init, so the partitions may not exist yet.
	n=0
	while [ $n -lt 60 ]; do
		grep -lq '^PARTNAME=modemst1' /sys/block/sd*/sd*/uevent 2>/dev/null && break
		sleep 1
		n=$((n + 1))
	done
	say "EFS partitions visible after ${n}s"

	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		name=$(sed -n 's/^PARTNAME=//p' "$d/uevent")
		case "$name" in
		modemst1) out=modem_fs1 ;;
		modemst2) out=modem_fs2 ;;
		fsg) out=modem_fsg ;;
		fsc) out=modem_fsc ;;
		oem_stanvbk|oem_dycnvbk) out=$name ;;
		*) continue ;;
		esac
		dev=/dev/${d##*/}
		[ -b "$dev" ] && dd if="$dev" of="/tmp/rmtfs/$out" bs=1M 2>/dev/null
	done

	# tqftpserv serves the WLAN firmware's /readwrite/ requests (MAC address,
	# calibration) out of /var/lib/tqftpserv.  Its mkdir() is not recursive,
	# so without the parent directory it cannot create the directory itself
	# and MPSS never publishes the WLFW service -- ath10k then waits forever
	# in its QMI lookup.  Populate it from persist, read-only.
	mkdir -p /var/lib/tqftpserv /tmp/persist
	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$d/uevent")" = persist ] || continue
		if mount -t ext4 -o ro "/dev/${d##*/}" /tmp/persist; then
			cp -a /tmp/persist/. /var/lib/tqftpserv/ 2>/dev/null
			umount /tmp/persist
		fi
		break
	done
	say "tqftpserv readwrite: $(ls /var/lib/tqftpserv 2>/dev/null | tr '\n' ' ')"

	# The modem partition carries the WLAN firmware image built for this
	# handset's modem.  Reusing another sm8150 device's wlanmdsp.mbn makes
	# ath10k's "assign msa map permissions" SCM call fail with -EINVAL, and
	# with qcom,msa-fixed-perm the WLAN subsystem then faults so hard that
	# the whole chip resets into EDL.  Read-only; nothing is written back.
	mkdir -p /tmp/modempart
	for d in /sys/block/sd*/sd*; do
		[ -r "$d/uevent" ] || continue
		[ "$(sed -n 's/^PARTNAME=//p' "$d/uevent")" = modem_a ] || continue
		if mount -t vfat -o ro "/dev/${d##*/}" /tmp/modempart; then
			cp -f /tmp/modempart/image/wlanmdsp.mbn \
				/lib/firmware/qcom/sm8150/oneplus7/ 2>/dev/null
			# The sensor DSP (SLPI, which runs the sensor core) is
			# loaded from the same FAT image, ~6 MB.
			for f in /tmp/modempart/image/slpi.*; do
				cp -f "$f" /lib/firmware/qcom/sm8150/oneplus7/ 2>/dev/null
			done
			# The audio DSP loads signed fragments too (13 MB), and the
			# DTS points it at qcom/sm8150/adsp.mdt.
			mkdir -p /lib/firmware/qcom/sm8150
			for f in /tmp/modempart/image/adsp.*; do
				cp -f "$f" /lib/firmware/qcom/sm8150/ 2>/dev/null
			done
			umount /tmp/modempart
			say "wlanmdsp $(wc -c < /lib/firmware/qcom/sm8150/oneplus7/wlanmdsp.mbn 2>/dev/null) bytes, slpi $(ls /lib/firmware/qcom/sm8150/oneplus7/slpi.b* 2>/dev/null | wc -l) + adsp $(ls /lib/firmware/qcom/sm8150/adsp.b* 2>/dev/null | wc -l) fragments"
		else
			say "modem_a mount failed"
		fi
		break
	done

	n=0
	while [ $n -lt 30 ] && [ ! -c /dev/qcom_rmtfs_mem1 ]; do
		sleep 1
		n=$((n + 1))
	done

	if [ -c /dev/qcom_rmtfs_mem1 ]; then
		/bin/rmtfs -o /tmp/rmtfs -v > /tmp/rmtfs.log 2>&1 &
	else
		say "no /dev/qcom_rmtfs_mem1"
	fi
	sleep 1
	/bin/pd-mapper > /tmp/pd-mapper.log 2>&1 &
	/bin/tqftpserv > /tmp/tqftpserv.log 2>&1 &
	sleep 1
	say "radio services up"

	# The sensor core (SSC) runs on the SLPI, whose firmware was copied
	# out of modem_a above.  pd-mapper must answer its protection-domain
	# lookup first, so this is done after the services are up.
	# The sensor core (SSC) runs on the SLPI and the audio DSP is the ADSP;
	# both load signed firmware that /init copied out of modem_a above.
	# pd-mapper must answer their protection-domain lookups first.
	for r in /sys/class/remoteproc/remoteproc*; do
		case "$(cat $r/name 2>/dev/null)" in
		slpi) fw=/lib/firmware/qcom/sm8150/oneplus7/slpi.mdt ;;
		adsp) fw=/lib/firmware/qcom/sm8150/adsp.mdt ;;
		*) continue ;;
		esac
		[ -f "$fw" ] || continue
		echo start > $r/state 2>/dev/null
		sleep 2
		say "$(cat $r/name) $(cat $r/state 2>/dev/null)"
	done

	# modem.mbn is 75 MB, which makes the boot image too big for
	# `fastboot boot` on this bootloader, so it is copied in afterwards and
	# /bin/radio_up.sh starts MPSS and the wireless modules.
	FW=/lib/firmware/qcom/sm8150/oneplus7
	if [ -f "$FW/modem.mbn" ]; then
		/bin/radio_up.sh > /tmp/radio.log 2>&1
	else
		say "modem.mbn absent; run /bin/radio_up.sh after copying it"
	fi
) &
fi


# ------------------------------------------------------------- usb drive -----
# A RAM-backed FAT image, exported to the host as a USB mass-storage LUN, so
# logs can be pulled off the board at USB speed.  Nothing on the real
# partitions is touched.
LUNIMG=/tmp/lun.img
LUN_OK=
if [ -z "$NETBOOT" ]; then
	dd if=/dev/zero of="$LUNIMG" bs=1M count=220 2>/dev/null
	if /bin/busybox.static mkfs.vfat -n HOTDOGB "$LUNIMG" >/dev/null 2>&1; then
		LUN_OK=1
		say "lun image ready"
	fi
fi

# ---------------------------------------------------------------- serial -----
# Nothing below may block this: the console is the only way to debug the board.
n=0
while [ $n -lt 60 ] && [ -z "$(ls /sys/class/udc 2>/dev/null)" ]; do
	sleep 1
	n=$((n + 1))
done
UDC=$(ls /sys/class/udc 2>/dev/null | head -1)

if [ -n "$UDC" ]; then
	mount -t configfs none /sys/kernel/config 2>/dev/null
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p "$G"
	# Linux Foundation CDC-ACM IDs: Windows binds usbser.sys and creates COMx.
	echo 0x1d6b > "$G/idVendor"
	echo 0x0104 > "$G/idProduct"
	echo 0x0100 > "$G/bcdDevice"
	echo 0x0200 > "$G/bcdUSB"
	mkdir -p "$G/strings/0x409"
	echo "dde12ac6" > "$G/strings/0x409/serialnumber"
	echo "OnePlus" > "$G/strings/0x409/manufacturer"
	echo "hotdogb mainline" > "$G/strings/0x409/product"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo "acm" > "$G/configs/c.1/strings/0x409/configuration"
	mkdir -p "$G/functions/acm.usb0"
	ln -sf "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
	if [ -n "$LUN_OK" ]; then
		mkdir -p "$G/functions/mass_storage.0"
		echo "$LUNIMG" > "$G/functions/mass_storage.0/lun.0/file"
		echo 1 > "$G/functions/mass_storage.0/lun.0/removable"
		ln -sf "$G/functions/mass_storage.0" "$G/configs/c.1/" 2>/dev/null
	fi
	if [ -n "$NETBOOT" ]; then
		# Windows 10 has a native CDC-NCM driver that matches the
		# Microsoft "WINNCM" compatible ID; its RNDIS template INF
		# does not match the OS descriptor, so NCM is the reliable
		# choice here.  Changing the product ID also gives Windows a
		# fresh device instance instead of the cached one.
		echo 0x0106 > "$G/idProduct"
		mkdir -p "$G/functions/ncm.usb0"
		mkdir -p "$G/functions/ncm.usb0/os_desc/interface.ncm"
		echo WINNCM > "$G/functions/ncm.usb0/os_desc/interface.ncm/compatible_id"
		mkdir -p "$G/os_desc"
		echo 0xcd > "$G/os_desc/b_vendor_code"
		echo MSFT100 > "$G/os_desc/qw_sign"
		echo 1 > "$G/os_desc/use"
		# os_desc_config is only set when the configuration is linked
		# into the os_desc group; without this Windows never sees the
		# Microsoft OS descriptors.
		ln -sf "$G/configs/c.1" "$G/os_desc"
		ln -sf "$G/functions/ncm.usb0" "$G/configs/c.1/" 2>/dev/null
		echo "acm+ncm" > "$G/configs/c.1/strings/0x409/configuration"
	fi
	echo "$UDC" > "$G/UDC"
	say "gadget bound to $UDC"
	if [ -n "$NETBOOT" ]; then
		# Rescue shell on the ACM port.  The netboot flow has no
		# command service, so this is the only way to poke at it.
		( sleep 2; sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1 ) &
	fi
else
	say "no UDC found, serial console unavailable"
fi

# --------------------------------------------------------------- netboot -----
# Connect the NBD root and hand over to it.  On failure stay in the initramfs
# so the serial console remains usable.
if [ -n "$UDC" ] && [ -n "$NETBOOT" ]; then
	n=0
	while [ $n -lt 20 ] && [ ! -e /sys/class/net/usb0 ]; do
		sleep 1
		n=$((n + 1))
	done
	if [ -e /sys/class/net/usb0 ]; then
		ip addr add 172.16.42.1/24 dev usb0 2>/dev/null
		ip link set usb0 up
		say "netboot: usb0 up"

		n=0
		while :; do
			nbd-client -b 4096 -t 30 "$NB_HOST" "$NB_PORT" "$NB_DEV" \
				>/tmp/nbd.log 2>&1 || {
				n=$((n + 1))
				[ $((n % 15)) -eq 1 ] && \
					say "netboot: waiting for $NB_HOST:$NB_PORT (try $n)"
				sleep 2
				continue
			}
			# nbd-client daemonises, so the device may still report
			# size 0 for a moment; mounting then reads garbage.
			i=0
			while [ $i -lt 20 ]; do
				[ "$(cat "/sys/block/${NB_DEV##*/}/size" 2>/dev/null)" != "0" ] && break
				i=$((i + 1))
				sleep 1
			done
			mkdir -p /newroot
			target=$NB_DEV
			[ -b "${NB_DEV}p1" ] && target="${NB_DEV}p1"
			if mount -t ext4 -o rw "$target" /newroot; then
				break
			fi
			say "netboot: mount $target failed, reconnecting"
			nbd-client -d "$NB_DEV" >/dev/null 2>&1
			sleep 2
		done

		say "netboot: mounted $target, switching root"
		mount -t proc proc /newroot/proc 2>/dev/null
		mount -t sysfs sysfs /newroot/sys 2>/dev/null
		mount -t devtmpfs devtmpfs /newroot/dev 2>/dev/null
		exec switch_root /newroot "$NB_INIT"
	else
		say "netboot: usb0 never appeared"
	fi
fi

# One command per line, output framed by __B__/__E__.  /bin/con is a tiny
# non-blocking server: a shell version deadlocks when the host closes COMx
# while a large output is still queued.  ttyGS0 only appears once the ACM
# function is bound, so the loop retries until it does.
(
	n=0
	while [ $n -lt 120 ] && [ ! -c /dev/ttyGS0 ]; do
		sleep 1
		n=$((n + 1))
	done
	say "console tty after ${n}s"
	while :; do
		/bin/con
		sleep 1
	done
) &

# PID 1 must never exit.
while :; do
	sleep 3600
done
