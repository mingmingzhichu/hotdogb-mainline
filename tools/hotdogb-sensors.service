[Unit]
Description=OnePlus 7T (hotdogb) SSC sensor stack (hexagonrpcd + registry)
Documentation=file:/usr/share/doc/hotdogb-radio
# The sensor PD runs on the SLPI, so the radio service has to bring SLPI up
# first; hexagonrpcd can only attach afterwards.  Attaching is what starts the
# PD and makes it read the sensor registry, so iio-sensor-proxy must not talk
# to the SSC before this unit has run (the start script restarts it).
#
# The sensor stack needs patches/0014: without the sdm845-shaped fastrpc node
# (reserved pool + qcom,vmids + one untranslated compute context) every attach
# faults the SLPI firmware
#   qcom_q6v5_pas: fatal error received: EX:sensor_process:0x1:frpck_0_0
#   arm-smmu: Unhandled context fault ... cbfrsynra=0x5a1
# and remoteproc then recovers the DSP.  The flag keeps the unit off by default
# until that path has been confirmed on hardware:
#
#     touch /etc/hotdogb-sensors.enable && systemctl start hotdogb-sensors
#
# Requires= pulls the radio chain in on demand, so nothing starts at boot.
ConditionPathExists=/etc/hotdogb-sensors.enable
Requires=hotdogb-radio.service
After=hotdogb-radio.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/hotdogb-sensors.sh start
ExecStop=/usr/local/sbin/hotdogb-sensors.sh stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
