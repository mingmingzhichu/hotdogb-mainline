From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hotdogb bring-up <noreply@example.com>
Date: Thu, 29 Oct 2026 23:20:00 +0800
Subject: [PATCH 6/6] arm64: dts: qcom: sm8150-oneplus-hotdogb: enable the touchscreen

The OnePlus 7T uses a Synaptics S3706 touch controller in RMI4 mode.  It
sits on QUPv3 SE17 (i2c17 at 0xc80000) at address 0x20, with a level low
interrupt on GPIO 122 and a reset line on GPIO 54.

Analogue power comes from PM8150L LDO17 (3.0V) and the 1.8V I/O rail is
behind a load switch enabled by GPIO 119, modelled here as a fixed
regulator.

Clip limits are taken from the vendor device tree (1079x2339).

Signed-off-by: hotdogb bring-up <noreply@example.com>
---
 arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdogb.dts | 76 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 76 insertions(+), 0 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdogb.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdogb.dts
--- a/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdogb.dts
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-hotdogb.dts
@@ -106,3 +106,79 @@
 		bias-pull-down;
 	};
 };
+
+/*
+ * Touchscreen: Synaptics S3706 (RMI4) on QUPv3 SE17.
+ *
+ * Stock wiring (from the vendor dtbo fragment targeting qupv3_se17_i2c):
+ *   reg 0x20, IRQ gpio122 (level low), reset gpio54, 1.8V load-switch
+ *   enable gpio119, analogue supply PM8150 L17 (3.0V).
+ */
+/ {
+	tp_1v8: regulator-tp-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "tp_1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+};
+
+&i2c17 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	touchscreen@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <122 IRQ_TYPE_LEVEL_LOW>;
+
+		vdd-supply = <&vreg_l17a_3p0>;
+		vio-supply = <&tp_1v8>;
+
+		reset-gpios = <&tlmm 54 GPIO_ACTIVE_LOW>;
+
+		syna,reset-delay-ms = <200>;
+		syna,startup-delay-ms = <100>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&tp_irq_pin &tp_reset_pin>;
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x01>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+			syna,rezero-wait-ms = <200>;
+			syna,clip-x-high = <1079>;
+			syna,clip-y-high = <2339>;
+		};
+	};
+};
+
+&tlmm {
+	tp_irq_pin: tp-irq-state {
+		pins = "gpio122";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	tp_reset_pin: tp-reset-state {
+		pins = "gpio54";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-high;
+	};
+};

