From c01023ad131f16f79d63ed953bfae469dc309559 Mon Sep 17 00:00:00 2001
From: mingmingzhichu <lihaoyu0717@outlook.com>
Date: Sat, 31 Oct 2026 16:36:38 +0800
Subject: [PATCH] dt-bindings: display: panel: add Samsung SOFEF03F

Document the Samsung SOFEF03F M FHD command mode panel with DSC as found on
the OnePlus 7T (hotdogb).

Signed-off-by: mingmingzhichu <lihaoyu0717@outlook.com>
---
 .../display/panel/samsung,sofef03f.yaml       | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/samsung,sofef03f.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,sofef03f.yaml b/Documentation/devicetree/bindings/display/panel/samsung,sofef03f.yaml
new file mode 100644
index 000000000..ef4e8a8df
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,sofef03f.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,sofef03f.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung SOFEF03F M FHD AMOLED DSI panel
+
+description: |
+  The SOFEF03F is a 1080x2400 command mode AMOLED panel from Samsung Mobile
+  Displays, found in the OnePlus 7T (hotdogb).  It is driven over four MIPI
+  DSI lanes and requires VESA DSC compression (two 540 pixel slices).
+
+maintainers:
+  - mingmingzhichu <lihaoyu0717@outlook.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,sofef03f
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low reset line
+
+  te-gpios:
+    description: Tearing effect signal from the panel
+
+  vddio-supply:
+    description: I/O supply (1.8V)
+
+  port: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+  - vddio-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,sofef03f";
+            reg = <0>;
+
+            vddio-supply = <&vreg_l14a_1p8>;
+
+            reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+            te-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&dsi0_out>;
+                };
+            };
+        };
+    };
+...
-- 
2.47.3

