From 00000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mingmingzhichu <lihaoyu0717@outlook.com>
Subject: [PATCH] drm msm-dsi-log-fifo-and-timeout-status-with-errors.patch

drm: msm: dsi: log the fifo and timeout status with the error state
Log the DSI FIFO and timeout status registers alongside the error state
so display failures can be diagnosed from a single line instead of a
follow-up register dump.
---
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 8c096d18d0d8554dd4af5c17e879a5ff21da9c0d..62222388844d2bf2aa60e71f0c6cab197e910fea 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -138,6 +138,8 @@ struct msm_dsi_host {
 	spinlock_t intr_lock; /* Protect interrupt ctrl register */
 
 	u32 err_work_state;
+	u32 err_fifo_status;
+	u32 err_timeout_status;
 	struct work_struct err_work;
 	struct workqueue_struct *workqueue;
 
@@ -1463,12 +1465,16 @@ static void dsi_err_worker(struct work_struct *work)
 		container_of(work, struct msm_dsi_host, err_work);
 	u32 status = msm_host->err_work_state;
 
-	pr_err_ratelimited("%s: status=%x\n", __func__, status);
+	pr_err_ratelimited("%s: status=%x fifo=%08x timeout=%08x\n", __func__,
+			   status, msm_host->err_fifo_status,
+			   msm_host->err_timeout_status);
 	if (status & DSI_ERR_STATE_MDP_FIFO_UNDERFLOW)
 		dsi_sw_reset(msm_host);
 
 	/* It is safe to clear here because error irq is disabled. */
 	msm_host->err_work_state = 0;
+	msm_host->err_fifo_status = 0;
+	msm_host->err_timeout_status = 0;
 
 	/* enable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
@@ -1496,6 +1502,7 @@ static void dsi_timeout_status(struct msm_dsi_host *msm_host)
 
 	if (status) {
 		dsi_write(msm_host, REG_DSI_TIMEOUT_STATUS, status);
+		msm_host->err_timeout_status = status;
 		msm_host->err_work_state |= DSI_ERR_STATE_TIMEOUT;
 	}
 }
@@ -1525,6 +1532,7 @@ static void dsi_fifo_status(struct msm_dsi_host *msm_host)
 	/* fifo underflow, overflow */
 	if (status) {
 		dsi_write(msm_host, REG_DSI_FIFO_STATUS, status);
+		msm_host->err_fifo_status = status;
 		msm_host->err_work_state |= DSI_ERR_STATE_FIFO;
 		if (status & DSI_FIFO_STATUS_CMD_MDP_FIFO_UNDERFLOW)
 			msm_host->err_work_state |=
