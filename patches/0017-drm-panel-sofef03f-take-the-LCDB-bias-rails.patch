From 6aeb632e5a46688f6dcb3f151468cf58b80fcb83 Mon Sep 17 00:00:00 2001
From: mingmingzhichu <lihaoyu0717@outlook.com>
Date: Sat, 28 Nov 2026 09:31:34 +0800
Subject: [PATCH 3/4] drm/panel: sofef03f: take the LCDB bias rails

The panel needs the 1.8V I/O rail plus the two LCDB bias rails: lab is
ELVDD (positive) and ibb is ELVSS (negative).  Now that the PM8150L LCDB
has a driver, model all three instead of depending on the bootloader
having left the bias up.  The order matches the vendor supply table.
---
 drivers/gpu/drm/panel/panel-samsung-sofef03f.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-sofef03f.c b/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
index ccd45bb9b..240849218 100644
--- a/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
+++ b/drivers/gpu/drm/panel/panel-samsung-sofef03f.c
@@ -61,13 +61,14 @@ struct sofef03f {
 };
 
 /*
- * The panel also needs the LCDB bias rails (lab/ibb) which come from the
- * PM8150L LCDB block.  Mainline has no driver for that block, so we rely on
- * the bootloader leaving them enabled (continuous splash).  Only vddio is
- * modelled here.
+ * Supply order matters: the 1.8V I/O rail comes up first, then the two LCDB
+ * bias rails - lab is ELVDD (positive), ibb is ELVSS (negative).  This is the
+ * order of the vendor's supply table and of the panel's power-up sequence.
  */
 static const struct regulator_bulk_data sofef03f_supplies[] = {
 	{ .supply = "vddio" },
+	{ .supply = "lab" },
+	{ .supply = "ibb" },
 };
 
 static inline struct sofef03f *to_sofef03f(struct drm_panel *panel)
