 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-samsung-sofef03f.c    | 479 ++++++++++++++++++
 3 files changed, 492 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-sofef03f.c

