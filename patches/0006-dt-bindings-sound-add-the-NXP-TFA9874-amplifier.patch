From eff29544872d00d8617829f26e4f471fbfac2d61 Mon Sep 17 00:00:00 2001
From: mingmingzhichu <lihaoyu0717@outlook.com>
Date: Sat, 7 Nov 2026 14:00:02 +0800
Subject: [PATCH] dt-bindings: sound: add the NXP TFA9874 amplifier

The TFA9874 is a class-D speaker amplifier without an internal DSP.  It
is controlled over I2C and takes its audio stream from an external TDM
or I2S source, so the binding only needs the I2C address and a single
sound-DAI cell.

Signed-off-by: mingmingzhichu <lihaoyu0717@outlook.com>
---
 .../bindings/sound/nxp,tfa9874.yaml           | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml

diff --git a/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml b/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml
new file mode 100644
index 000000000..b02b85494
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/nxp,tfa9874.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/nxp,tfa9874.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NXP TFA9874 class-D audio amplifier
+
+maintainers:
+  - mingmingzhichu <lihaoyu0717@outlook.com>
+
+description: |
+  The TFA9874 is a smart class-D speaker amplifier without an internal audio
+  DSP. Speaker protection and calibration can be provided by an external DSP.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: nxp,tfa9874
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-codec@34 {
+            compatible = "nxp,tfa9874";
+            reg = <0x34>;
+            #sound-dai-cells = <0>;
+        };
+    };
